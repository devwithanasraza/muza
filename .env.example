# ============================================================
# MUZA AI Content Publishing Platform - Environment Configuration
# ============================================================

# 1. Database (MANDATORY: MySQL 8+ ONLY)
DATABASE_URL="mysql://muza_user:muza_password@localhost:3306/muza_db"

# 2. Redis (BullMQ Queue Processing & Locks ONLY - MySQL is Source of Truth)
REDIS_URL="redis://localhost:6379"

# 3. Google OAuth & Google Drive API
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"

# 4. YouTube Data API v3
# Can share Google Cloud Project with Drive or use distinct YouTube App credentials
YOUTUBE_CLIENT_ID="your-youtube-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="GOCSPX-your-youtube-client-secret"
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"

# 5. Meta Graph API & Instagram Content Publishing API
# Create at https://developers.facebook.com/ (Meta App with Instagram Graph API & Pages permissions)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:3000/api/instagram/callback"

# 6. AI Video & Copywriting Engine (OpenAI)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# 7. Cryptography & Security
# 32-byte secret key used for AES-256-GCM OAuth token encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT secret key for session authorization
SESSION_SECRET="muza-production-super-secret-jwt-key-replace-in-production!"

# 8. Service URLs & Ports
PORT=4000
HOST="0.0.0.0"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
